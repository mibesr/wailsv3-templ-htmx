package components

templ Footer() {
	<footer class="mt-12 border-t border-slate-200 pt-4 text-sm text-slate-600">
		<p class="mb-2 font-semibold">Learn more</p>
		<ul class="space-y-1">
			<li><a class="text-slate-800 underline" href="https://v3.wails.io" target="_blank">Wails v3</a></li>
			<li><a class="text-slate-800 underline" href="https://htmx.org/docs" target="_blank">HTMX</a></li>
			<li><a class="text-slate-800 underline" href="https://templ.guide" target="_blank">Templ</a></li>
			<li><a class="text-slate-800 underline" href="https://tailwindcss.com/docs" target="_blank">Tailwind CSS</a></li>
		</ul>
	</footer>
}
